# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Never put the service_role / secret key here: it ships inside the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# MQTT broker. The scoring phone publishes each confirmed score to scores/<MatchID>; streaming phones subscribe.
# For a broker on your Mac, use the Mac's address on the phones' network (System Settings → Wi-Fi → Details).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
